[Unit]
Description=BuildKit daemon (rootless, mutual TLS on :1234)
Wants=network-online.target
After=network-online.target buildkit-imds-guard.service
Requires=buildkit-imds-guard.service
RequiresMountsFor=/var/lib/buildkit

[Service]
Type=simple
User=buildkit
Group=buildkit
Environment=HOME=/var/lib/buildkit-home XDG_RUNTIME_DIR=/run/buildkit
RuntimeDirectory=buildkit
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/rootlesskit --state-dir=/run/buildkit/rootlesskit --net=host /usr/local/bin/buildkitd --config=/etc/buildkit/buildkitd.toml
Delegate=yes
KillMode=mixed
TimeoutStopSec=120
Restart=always
RestartSec=5
LimitNOFILE=1048576
TasksMax=infinity
MemoryHigh=85%
MemoryMax=92%
CPUWeight=50
