n:@PARTITION@:ssm:eu-west-1:@ACCOUNT@:parameter/ci/test/buildkit-server/client-ca\"\n          ],\n          \"kms:ViaService\": [\n            \"ssm.eu-west-1.amazonaws.com\"\n          ]\n        }\n      }\n    }\n  ]\n}"
