        ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"TagActivity2\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:CreateTags\"\n      ],\n      \"Resource\": [\n        \"arn:@PARTITION@:ec2:eu-west-1:@ACCOUNT@:instance/*\"\n      ],\n      \"Condition\": {\n        \"ForAllValues:StringEquals\": {\n          \"aws:TagKeys\": [\n            \"wake-proxy/last-active\"\n          ]\n        },\n        \"StringEquals\": {\n          \"aws:ResourceTag/role\": [\n            \"devel-buildkit-arm64\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"UseTargetVolumeKeys\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:Decrypt\",\n        \"kms:GenerateDataKeyWithoutPlaintext\"\n      ],\n      \"Resource\": [\n        \"arn:@PARTITION@:kms:eu-west-1:@ACCOUNT@:key/0example-key\"\n      ]\n    },\n    {\n      \"Sid\": \"GrantTargetVolumeKeys\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:CreateGrant\"\n      ],\n      \"Resource\": [\n        \"arn:@PARTITION@:kms:eu-west-1:@ACCOUNT@:key/0example-key\"\n      ],\n      \"Condition\": {\n        \"Bool\": {\n          \"kms:GrantIsForAWSResource\": [\n            \"true\"\n          ]\n        }\n      }\n    }\n  ]\n}"
